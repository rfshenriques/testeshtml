---
/**
 * Shared document shell for every generated page: robots noindex, Open Graph,
 * LocalBusiness JSON-LD, theme tokens, mockup banner and mockup footer.
 */
import type { BuildInput } from '../lib/input';
import { jsonForScript, localBusinessJsonLd, telHref } from '../lib/input';
import { themeCss } from '../theme/tokens';
import MockupBanner from '../components/MockupBanner.astro';
import MockupFooter from '../components/MockupFooter.astro';

interface Props { input: BuildInput }
const { input } = Astro.props;
const { brief, copy, mockup } = input;
const lang = (brief.languageCode || brief.classification.languageCode || 'en').split(/[-_]/)[0] || 'en';
const theme = themeCss(input.template, input.colourScheme, input.typography, input.brand ?? null);
const jsonLd = jsonForScript(localBusinessJsonLd(input));
// Mobile action dock: the one thing a visitor on a phone wants to do for this kind of business, plus a call button.
const DOCK: Record<string, { label: string; href: string }> = {
  hospitality: { label: 'Reserve a table', href: mockup.bookingUrl },
  beauty: { label: 'Book a chair', href: mockup.bookingUrl },
  clinic: { label: 'Book an appointment', href: mockup.bookingUrl },
  trades: { label: 'Book a call-out', href: mockup.bookingUrl },
  automotive: { label: 'Book a service', href: mockup.bookingUrl },
  professional: { label: 'Book a consultation', href: mockup.bookingUrl },
  property: { label: 'Book a valuation', href: mockup.bookingUrl },
  education: { label: 'Book a visit', href: mockup.bookingUrl },
  retail: { label: 'Opening hours', href: '#store' },
  fitness: { label: 'Book a trial', href: mockup.bookingUrl },
};
const dock = DOCK[input.template] ?? { label: 'Book online', href: mockup.bookingUrl };
const dockTel = telHref(brief.phone, brief.internationalPhone);
---
<!doctype html>
<html lang={lang} data-template={input.template} data-scheme={input.colourScheme} data-type={input.typography}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:site_name" content={brief.businessName} />
    <meta property="og:locale" content={lang} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <style is:inline set:html={theme}></style>
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <MockupBanner agencyName={mockup.agencyName} agencyUrl={mockup.agencyUrl} businessName={mockup.businessName} />
    <slot />
    <MockupFooter input={input} />
    <nav class="ap-dock" aria-label="Quick actions">
      {dockTel && <a class="ap-dock__call" href={dockTel}>Call</a>}
      <a class="ap-dock__main" href={dock.href}>{dock.label}</a>
    </nav>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img, iframe { max-width: 100%; display: block; }
  img { height: auto; }
  h1, h2, h3, h4 {
    font-family: var(--font-display); font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking); text-transform: var(--display-transform);
    line-height: 1.12; margin: 0 0 0.5em; color: inherit; text-wrap: balance;
  }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.75rem); }
  h2 { font-size: clamp(1.7rem, 3.5vw, 2.5rem); }
  h3 { font-size: 1.25rem; line-height: 1.3; }
  p { margin: 0 0 1em; }
  a { color: var(--primary); text-underline-offset: 0.15em; }
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
    outline: 3px solid var(--accent); outline-offset: 2px;
  }
  ul { margin: 0; padding: 0; list-style: none; }
  .container { width: min(100% - 2rem, 72rem); margin-inline: auto; }
  .skip-link { position: absolute; left: 1rem; top: -4rem; background: var(--primary); color: var(--on-primary); padding: 0.5rem 1rem; border-radius: 4px; z-index: 100; }
  .skip-link:focus { top: 1rem; }

  /* Mockup disclosure: sticky, no close control, always first in the DOM. */
  .mockup-banner { position: sticky; top: 0; z-index: 50; background: #111111; color: #ffffff; text-align: center; font-size: 0.9rem; line-height: 1.4; padding: 0.55rem 1rem; border-bottom: 2px solid #ffd166; }
  .mockup-banner p { margin: 0; }
  .mockup-banner a { color: #ffd166; font-weight: 600; }

  /* Header */
  .site-header { background: var(--surface); border-bottom: 1px solid var(--border); }
  .site-header__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 0.9rem 0; }
  .site-nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; }
  .site-nav a { color: var(--text); text-decoration: none; font-size: 0.95rem; font-family: var(--font-label); text-transform: var(--label-transform); letter-spacing: 0.04em; }
  .site-nav a:hover { color: var(--primary); text-decoration: underline; }
  .site-header__cta { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .wordmark { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); text-transform: var(--display-transform); color: var(--primary); text-decoration: none; line-height: 1.1; }
  .wordmark--sm { font-size: 1.45rem; }
  .wordmark--lg { font-size: clamp(2.5rem, 7vw, 5rem); }
  .wordmark:hover { text-decoration: underline; }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.7rem 1.25rem; border-radius: 6px; font-weight: 600; text-decoration: none; border: 2px solid transparent; cursor: pointer; font-family: var(--font-body); font-size: 1rem; line-height: 1.2; }
  .btn-primary { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }
  .btn-primary:hover { filter: brightness(1.1); }
  .btn-accent { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .btn-outline { background: transparent; color: var(--primary); border-color: currentColor; }
  .btn-on-hero { background: var(--on-hero); color: var(--hero-bg); border-color: var(--on-hero); }
  .btn-ghost-hero { background: transparent; color: var(--on-hero); border-color: currentColor; }
  .btn-lg { padding: 0.95rem 1.6rem; font-size: 1.1rem; }

  /* Sections */
  .section { padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .section--surface { background: var(--surface); border-block: 1px solid var(--border); }
  .section--dark { background: var(--hero-bg); color: var(--on-hero); }
  .section--dark a:not(.btn) { color: var(--on-hero); }
  .section__head { max-width: 46rem; margin-bottom: 2.25rem; }
  .section__head--center { margin-inline: auto; text-align: center; }
  .eyebrow { display: block; font-family: var(--font-label); text-transform: var(--label-transform); letter-spacing: 0.12em; font-size: 0.8rem; font-weight: 600; color: var(--accent); margin-bottom: 0.75rem; }
  .section--dark .eyebrow { color: var(--on-hero); opacity: 0.85; }
  .lead { font-size: 1.15rem; color: var(--muted); }
  .section--dark .lead { color: var(--on-hero); opacity: 0.9; }
  .grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .grid--2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; }
  .section--surface .card { background: var(--bg); }
  .card h3 { margin-top: 0; }
  .card p:last-child { margin-bottom: 0; }
  .muted { color: var(--muted); }
  .ph { color: var(--muted); font-style: italic; border-bottom: 1px dashed var(--muted); }
  .badge { display: inline-block; font-family: var(--font-label); text-transform: var(--label-transform); letter-spacing: 0.08em; font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--bg); color: var(--text); border: 1px solid var(--border); }
  .split { display: grid; gap: 2.5rem; align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .img-frame { border-radius: 12px; overflow: hidden; background: #e4e4e4; }
  .img-frame img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: var(--ratio, 4 / 3); }
  .credit { font-size: 0.8rem; color: var(--muted); margin: 0.4rem 0 0; }
  .facts { display: grid; gap: 0.5rem; }
  .facts li { padding-left: 1.4rem; position: relative; }
  .facts li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 0.7rem; height: 0.7rem; border-radius: 2px; background: var(--accent); }

  /* Hero */
  .hero { background: var(--hero-bg); color: var(--on-hero); padding: clamp(3.5rem, 9vw, 7rem) 0; }
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .hero .eyebrow { color: var(--on-hero); opacity: 0.8; }
  .hero p.lead { color: var(--on-hero); opacity: 0.92; font-size: clamp(1.1rem, 2vw, 1.35rem); max-width: 36rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__meta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; font-size: 0.95rem; opacity: 0.9; }
  .hero .img-frame { box-shadow: 0 24px 60px rgba(0,0,0,0.25); }
  .hero .credit { color: var(--on-hero); opacity: 0.75; }
  .hero--stacked .hero__grid { grid-template-columns: 1fr; text-align: center; }
  .hero--stacked .hero__actions, .hero--stacked .hero__meta { justify-content: center; }
  .hero--stacked p.lead { margin-inline: auto; }
  .hero--stacked .hero__media { max-width: 56rem; margin: 2.5rem auto 0; }

  /* Hours + map */
  .hours-table { width: 100%; border-collapse: collapse; font-size: 0.98rem; }
  .hours-table th, .hours-table td { text-align: left; padding: 0.55rem 0; border-bottom: 1px solid var(--border); vertical-align: top; }
  .hours-table th { font-weight: 600; width: 40%; }
  .map { border-radius: 12px; overflow: hidden; border: 1px solid var(--border); background: #e4e4e4; min-height: 18rem; }
  .map iframe { width: 100%; height: 100%; min-height: 18rem; border: 0; }
  .map--placeholder { display: grid; place-items: center; text-align: center; color: #333; padding: 2rem; background: repeating-linear-gradient(45deg, #e4e4e4 0 12px, #dadada 12px 24px); }
  .map--placeholder p { margin: 0.25rem 0; }

  /* Reviews */
  .rating { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .rating__stars { color: var(--accent); letter-spacing: 0.1em; font-size: 1.3rem; }
  .section--dark .rating__stars { color: var(--on-hero); }
  .rating__value { font-family: var(--font-display); font-size: 2rem; font-weight: var(--display-weight); line-height: 1; }
  .review { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin: 0; }
  .section--dark .review { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); }
  .review p { font-size: 1.05rem; margin: 0; }
  .review p::before { content: '“'; } .review p::after { content: '”'; }
  .review footer { margin-top: 0.75rem; font-size: 0.85rem; opacity: 0.8; }

  /* Form */
  .form { display: grid; gap: 1rem; }
  .form__row { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .form label { display: grid; gap: 0.35rem; font-weight: 600; font-size: 0.95rem; }
  .form input, .form textarea, .form select { font: inherit; padding: 0.7rem 0.85rem; border: 1px solid var(--muted); border-radius: 6px; background: var(--surface); color: var(--text); width: 100%; }
  .form textarea { min-height: 7rem; resize: vertical; }
  .form__note { font-size: 0.9rem; color: var(--muted); background: var(--bg); border: 1px dashed var(--muted); border-radius: 6px; padding: 0.75rem 1rem; margin: 0; }

  /* CTA band */
  .cta-band { text-align: center; }
  .cta-band .container { max-width: 44rem; }
  .cta-band .hero__actions { justify-content: center; }

  /* Gallery */
  .gallery { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .gallery figure { margin: 0; }
  .gallery figcaption { font-size: 0.9rem; color: var(--muted); margin-top: 0.4rem; }

  /* Footer */
  .site-footer { background: var(--hero-bg); color: var(--on-hero); padding: 3rem 0 2.5rem; font-size: 0.93rem; }
  .site-footer a { color: var(--on-hero); }
  .site-footer .wordmark { color: var(--on-hero); }
  .site-footer__grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .site-footer__addr { margin-top: 0.75rem; }
  .site-footer__mockup p { margin-bottom: 0.6rem; opacity: 0.92; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media print { .mockup-banner { position: static; } }

  /* ------------------------------------------------------------------------------------------------------------------
     Apple-style interface layer (WWDC "Designing Fluid Interfaces", translated for static pages: no JavaScript).
     Response: feedback on press, no tap delay. Springs: critically damped by default, a touch of bounce only where the
     business is playful. Materials: translucent sticky chrome. Type: size-specific tracking and leading.
     Each family sets its own character through the --ap-* tokens below. Everything honours reduced motion,
     reduced transparency and increased contrast.
     ------------------------------------------------------------------------------------------------------------------ */
  html {
    --ap-spring: linear(0, 0.0411, 0.134, 0.2475, 0.3635, 0.4721, 0.5688, 0.652, 0.7219, 0.7795, 0.8264, 0.8641, 0.8942, 0.9179, 0.9366, 0.9512, 0.9625, 0.9713, 0.9781, 0.9833, 0.9873, 0.9904, 1);
    --ap-spring-bounce: linear(0, 0.0383, 0.1302, 0.2488, 0.3755, 0.4982, 0.6097, 0.7064, 0.7871, 0.8521, 0.9028, 0.9411, 0.969, 0.9884, 1.0013, 1.0091, 1.0134, 1.015, 1.015, 1.0139, 1.0122, 1.0103, 1.0084, 1.0067, 1.0051, 1.0038, 1.0027, 1.0018, 1.0011, 1.0006, 1);
    --ap-ease: var(--ap-spring);
    --ap-dur: 0.4s;
    --ap-press: 0.97;
    --ap-lift: -2px;
    --ap-blur: 18px;
    --ap-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 10px 28px rgb(0 0 0 / 0.07);
    --ap-zoom: 1.03;
    --ap-h1-track: -0.025em;
    --ap-h1-lead: 1.06;
    --ap-pill: 12px;
  }
  /* Character per kind of business. */
  html[data-template="hospitality"] { --ap-dur: 0.5s; --ap-lift: -3px; --ap-zoom: 1.04; --ap-pill: 12px; --ap-shadow: 0 1px 2px rgb(60 30 10 / 0.06), 0 14px 34px rgb(60 30 10 / 0.1); }
  html[data-template="beauty"] { --ap-dur: 0.55s; --ap-lift: -2px; --ap-press: 0.98; --ap-zoom: 1.025; --ap-pill: 999px; --ap-h1-track: -0.03em; --ap-shadow: 0 1px 1px rgb(0 0 0 / 0.03), 0 18px 40px rgb(80 30 50 / 0.08); }
  html[data-template="clinic"] { --ap-dur: 0.4s; --ap-lift: -1px; --ap-press: 0.98; --ap-zoom: 1; --ap-pill: 10px; --ap-h1-track: -0.02em; --ap-shadow: 0 1px 2px rgb(0 40 60 / 0.06), 0 8px 22px rgb(0 40 60 / 0.06); }
  html[data-template="trades"] { --ap-dur: 0.28s; --ap-lift: -2px; --ap-press: 0.96; --ap-zoom: 1; --ap-pill: 4px; --ap-h1-track: -0.015em; --ap-shadow: 0 2px 0 rgb(0 0 0 / 0.12), 0 10px 22px rgb(0 0 0 / 0.1); }
  html[data-template="automotive"] { --ap-dur: 0.3s; --ap-lift: -2px; --ap-press: 0.96; --ap-zoom: 1.04; --ap-pill: 3px; --ap-h1-track: -0.02em; --ap-shadow: 0 2px 0 rgb(0 0 0 / 0.14), 0 14px 30px rgb(0 0 0 / 0.14); }
  html[data-template="professional"] { --ap-dur: 0.3s; --ap-lift: 0px; --ap-press: 0.985; --ap-zoom: 1; --ap-pill: 2px; --ap-h1-track: -0.018em; --ap-h1-lead: 1.1; --ap-shadow: none; }
  html[data-template="property"] { --ap-dur: 0.5s; --ap-lift: -2px; --ap-press: 0.98; --ap-zoom: 1.05; --ap-pill: 8px; --ap-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 16px 40px rgb(0 0 0 / 0.1); }
  html[data-template="education"] { --ap-ease: var(--ap-spring-bounce); --ap-dur: 0.5s; --ap-lift: -3px; --ap-press: 0.95; --ap-zoom: 1.03; --ap-pill: 999px; --ap-h1-track: -0.02em; --ap-shadow: 0 2px 4px rgb(40 40 120 / 0.06), 0 12px 28px rgb(40 40 120 / 0.1); }
  html[data-template="retail"] { --ap-ease: var(--ap-spring-bounce); --ap-dur: 0.4s; --ap-lift: -3px; --ap-press: 0.96; --ap-zoom: 1.05; --ap-pill: 10px; --ap-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 12px 28px rgb(0 0 0 / 0.09); }
  html[data-template="fitness"] { --ap-ease: var(--ap-spring-bounce); --ap-dur: 0.32s; --ap-lift: -3px; --ap-press: 0.94; --ap-zoom: 1.04; --ap-pill: 2px; --ap-h1-track: -0.012em; --ap-h1-lead: 1; --ap-shadow: 0 3px 0 rgb(0 0 0 / 0.18), 0 14px 28px rgb(0 0 0 / 0.16); }

  /* Response: no tap delay, no grey tap flash; feedback on press, not release. */
  html { -webkit-tap-highlight-color: transparent; scroll-padding-top: 5.5rem; }
  a, button, summary, input, select, textarea, label { touch-action: manipulation; }
  ::selection { background: color-mix(in srgb, var(--accent) 28%, transparent); }

  /* Type: tracking and leading depend on size. Large text tightens, small text opens up. */
  h1 { letter-spacing: min(var(--display-tracking), var(--ap-h1-track)); line-height: var(--ap-h1-lead); font-optical-sizing: auto; }
  h2 { letter-spacing: min(var(--display-tracking), -0.02em); line-height: 1.1; font-optical-sizing: auto; }
  h3, h4 { letter-spacing: max(var(--display-tracking), -0.008em); line-height: 1.25; }
  p, li { text-wrap: pretty; }
  .lead { line-height: 1.45; letter-spacing: -0.005em; }
  small, .credit, .muted.small, figcaption, .hours-table, .site-footer { letter-spacing: 0.006em; }
  body { font-feature-settings: 'kern', 'liga', 'calt'; text-rendering: optimizeLegibility; }
  .hours-table td, .hours-table th, .rating__value, time { font-variant-numeric: tabular-nums; }

  /* Springs: everything that can be pressed or hovered animates from its current value with a spring. */
  :where(.btn, a.btn, button, summary, .card, .review, .badge) { transition: transform var(--ap-dur) var(--ap-ease), box-shadow 0.25s ease-out, background-color 0.2s ease-out, border-color 0.2s ease-out, color 0.2s ease-out, filter 0.2s ease-out; }
  :where(a:not(.btn)) { transition: color 0.2s ease-out, text-decoration-color 0.2s ease-out, opacity 0.2s ease-out; }
  .btn:active, button:active, summary:active { transform: scale(var(--ap-press)); transition-duration: 90ms; transition-timing-function: ease-out; }
  .img-frame img { transition: transform 0.9s var(--ap-spring); }
  .form input, .form textarea, .form select { transition: border-color 0.2s ease-out, box-shadow 0.25s ease-out, background-color 0.2s ease-out; }
  .form input:focus, .form textarea:focus, .form select:focus { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent); outline: none; border-color: var(--accent); }
  :focus-visible { outline-offset: 3px; transition: outline-offset 0.2s var(--ap-spring); }
  details > :not(summary) { animation: ap-in var(--ap-dur) var(--ap-ease) both; }
  @keyframes ap-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @media (hover: hover) and (pointer: fine) {
    .btn:hover { transform: translateY(var(--ap-lift)); }
    .btn:active { transform: scale(var(--ap-press)); }
    .card:hover, .review:hover { transform: translateY(var(--ap-lift)); box-shadow: var(--ap-shadow); }
    .img-frame:hover img { transform: scale(var(--ap-zoom)); }
  }

  /* Materials: the sticky disclosure banner is a translucent layer, content scrolls under it. */
  .mockup-banner { background: rgb(17 17 17 / 0.93); -webkit-backdrop-filter: blur(var(--ap-blur)) saturate(180%); backdrop-filter: blur(var(--ap-blur)) saturate(180%); border-bottom: 2px solid #ffd166; }

  /* Mobile action dock: the primary action for this kind of business, one thumb away. Translucent, safe-area aware. */
  .ap-dock { display: none; }
  @media (max-width: 47.99rem) {
    body { padding-bottom: calc(4.75rem + env(safe-area-inset-bottom)); }
    .ap-dock {
      display: flex; gap: 0.5rem; position: fixed; left: 0.75rem; right: 0.75rem; bottom: calc(0.75rem + env(safe-area-inset-bottom)); z-index: 40;
      padding: 0.45rem; border-radius: calc(var(--ap-pill) + 6px); border: 1px solid rgb(255 255 255 / 0.5);
      background: color-mix(in srgb, var(--surface) 90%, transparent); -webkit-backdrop-filter: blur(calc(var(--ap-blur) + 6px)) saturate(180%); backdrop-filter: blur(calc(var(--ap-blur) + 6px)) saturate(180%);
      box-shadow: var(--ap-shadow), 0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent);
    }
    .ap-dock a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; border-radius: var(--ap-pill); font-weight: 650; text-decoration: none; transition: transform var(--ap-dur) var(--ap-ease), filter 0.2s ease-out; }
    .ap-dock a:active { transform: scale(var(--ap-press)); transition-duration: 90ms; }
    .ap-dock__call { padding: 0 1.1rem; color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, var(--surface)); }
