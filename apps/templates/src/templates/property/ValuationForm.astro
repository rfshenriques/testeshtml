---
/** property: valuation request form posting to the mockup endpoint (same contract as ContactForm). */
import type { BuildInput } from '../../lib/input';
interface Props { input: BuildInput; submitLabel: string }
const { input, submitLabel } = Astro.props;
const { mockup, brief } = input;
---
<form class="form" method="post" action={mockup.formEndpoint} id="form-valuation" aria-describedby="form-valuation-note">
  <input type="hidden" name="previewSlug" value={mockup.previewSlug} />
  <input type="hidden" name="business" value={brief.businessName} />
  <input type="hidden" name="formVariant" value="valuation" />
  <label>Property address<input type="text" name="propertyAddress" autocomplete="street-address" required /></label>
  <div class="form__row">
    <label>I would like to
      <select name="intent">
        <option value="sell">Sell</option>
        <option value="let">Let</option>
        <option value="undecided">Not sure yet</option>
      </select>
    </label>
    <label>Postcode<input type="text" name="postcode" autocomplete="postal-code" /></label>
  </div>
  <div class="form__row">
    <label>Your name<input type="text" name="name" autocomplete="name" required /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
  </div>
  <div class="form__row">
    <label>Phone (optional)<input type="tel" name="phone" autocomplete="tel" /></label>
    <label>Preferred time to visit (optional)<input type="text" name="preferredTime" /></label>
  </div>
  <label>Anything we should know? (optional)<textarea name="message"></textarea></label>
  <p class="form__note" id="form-valuation-note">This is a mockup — your message was recorded for demonstration and is not delivered to {brief.businessName}.</p>
  <div><button class="btn btn-primary btn-lg" type="submit">{submitLabel}</button></div>
</form>
