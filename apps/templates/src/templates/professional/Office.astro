---
/** professional: address + phone, the hours table and a small map, as three hairline columns. */
import type { BuildInput } from '../../lib/input';
import { telHref } from '../../lib/input';
interface Props { input: BuildInput }
const { input } = Astro.props;
const { brief, mockup } = input;
const tel = telHref(brief.phone, brief.internationalPhone);
const hasCoords = brief.lat !== null && brief.lng !== null;
---
<div class="office">
  <div class="office__col">
    <h3>The office</h3>
    {brief.address ? <p>{brief.address}</p> : <p class="ph">Address to be confirmed by the business</p>}
    {tel && <p>Telephone <a href={tel}>{brief.phone ?? brief.internationalPhone}</a></p>}
    {brief.city && <p class="muted">Meetings in {brief.city} by appointment.</p>}
  </div>
  <div class="office__col">
    <h3>Office hours</h3>
    {brief.openingHours.length ? (
      <table class="hours-table">
        <caption class="visually-hidden">Office hours for {brief.businessName}</caption>
        <tbody>{brief.openingHours.map((h) => <tr><th scope="row">{h.day}</th><td>{h.hours}</td></tr>)}</tbody>
      </table>
    ) : (
      <p class="ph">Office hours to be confirmed by the business</p>
    )}
  </div>
  <div class="office__col office__map map" class:list={[!mockup.mapEmbedUrl && 'map--placeholder']}>
    {mockup.mapEmbedUrl ? (
      <iframe src={mockup.mapEmbedUrl} title={`Map showing the location of ${brief.businessName}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen width="600" height="400"></iframe>
    ) : (
      <div>
        <p><strong>Map placeholder</strong></p>
        {brief.address && <p>{brief.address}</p>}
        {hasCoords && <p class="muted">{brief.lat!.toFixed(5)}, {brief.lng!.toFixed(5)}</p>}
        <p class="muted">An interactive map will be embedded on the live site.</p>
      </div>
    )}
  </div>
</div>
<style>
  .office { display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); border-top: 1px solid var(--text); padding-top: 2rem; }
  .office h3 { font-family: var(--font-label); text-transform: var(--label-transform); letter-spacing: 0.12em; font-size: 0.78rem; font-weight: 600; color: var(--muted); margin-bottom: 1rem; }
  .office p { margin: 0 0 0.5rem; }
  .office__col a { color: var(--text); }
  .office__map { border-radius: 0; min-height: 14rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
