---
/**
 * Plain HTML form posting to mockup.formEndpoint (spec §9.2). No JavaScript.
 * Before conversion the endpoint records the message and the preview shows a
 * "this is a mockup" confirmation; the note below says so up front.
 */
import type { BuildInput } from '../lib/input';
interface Props { input: BuildInput; variant?: 'contact' | 'quote' | 'booking' | 'trial'; submitLabel?: string; intro?: string }
const { input, variant = 'contact', submitLabel, intro } = Astro.props;
const { mockup, brief } = input;
const labels = {
  contact: { submit: 'Send message', message: 'Your message' },
  quote: { submit: 'Request a quote', message: 'Describe the job' },
  booking: { submit: 'Request an appointment', message: 'What would you like to book, and when suits you?' },
  trial: { submit: 'Request a trial', message: 'Tell us about your goals (optional)' },
}[variant];
const formId = `form-${variant}`;
---
<form class="form" method="post" action={mockup.formEndpoint} id={formId} aria-describedby={`${formId}-note`}>
  <input type="hidden" name="previewSlug" value={mockup.previewSlug} />
  <input type="hidden" name="business" value={brief.businessName} />
  <input type="hidden" name="formVariant" value={variant} />
  {intro && <p class="lead">{intro}</p>}
  <div class="form__row">
    <label>Your name<input type="text" name="name" autocomplete="name" required /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
  </div>
  <div class="form__row">
    <label>Phone (optional)<input type="tel" name="phone" autocomplete="tel" /></label>
    {variant === 'booking' || variant === 'trial' ? (
      <label>Preferred date (optional)<input type="date" name="preferredDate" /></label>
    ) : null}
  </div>
  <label>{labels.message}<textarea name="message" required={variant !== 'trial'}></textarea></label>
  <p class="form__note" id={`${formId}-note`}>This is a mockup — your message was recorded for demonstration and is not delivered to {brief.businessName}.</p>
  <div>
    <button class="btn btn-primary btn-lg" type="submit">{submitLabel ?? labels.submit}</button>
  </div>
</form>
