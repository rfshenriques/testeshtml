---
/**
 * The single generated page. scripts/build-site.ts sets SITEWRIGHT_INPUT to a
 * validated SiteBuildInput JSON file; the matching template family renders it.
 * Without SITEWRIGHT_INPUT (plain `astro build`) a placeholder page is emitted.
 */
import { loadBuildInput } from '../lib/input';
import Hospitality from '../templates/hospitality/Site.astro';
import Appointment from '../templates/appointment/Site.astro';
import Trades from '../templates/trades/Site.astro';
import Professional from '../templates/professional/Site.astro';
import Retail from '../templates/retail/Site.astro';
import Fitness from '../templates/fitness/Site.astro';

const input = loadBuildInput();
const templates = { hospitality: Hospitality, appointment: Appointment, trades: Trades, professional: Professional, retail: Retail, fitness: Fitness } as const;
const Site = input ? templates[input.template] : null;
---
{input && Site ? (
  <Site input={input} />
) : (
  <html lang="en">
    <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Sitewright templates</title></head>
    <body><p>Sitewright template workspace. Build a site with <code>pnpm build:site &lt;input.json&gt; &lt;outDir&gt;</code>.</p></body>
  </html>
)}
