# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitewright?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitewright_test?schema=public
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
ADMIN_API_TOKEN=change-me-admin-token

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_DAILY_REQUEST_CAP=5000

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_DAILY_USD_CAP=25
LLM_INPUT_USD_PER_MTOK=3                       # verify current pricing; used for the cost ledger
LLM_OUTPUT_USD_PER_MTOK=15
LLM_PROVIDER=anthropic                         # anthropic|fake

# Storage
STORAGE_DRIVER=local                           # local (dev) | s3 (R2 / S3 / MinIO)
LOCAL_STORAGE_DIR=.work/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_URL_STYLE=path                              # path (MinIO) | virtual-host (Railway buckets, AWS)
S3_BUCKET_PREVIEWS=sitewright-previews
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
PREVIEW_HOST=http://localhost:3000/p          # separate domain in production
QUOTE_HOST=http://localhost:3000/q

# Email
EMAIL_PROVIDER=fake                            # ses|smartlead|fake
AWS_SES_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMARTLEAD_API_KEY=
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
TRACKING_HOST=http://localhost:3000/t          # subdomain of the sending domain in production

# Enrichment
COMPANIES_HOUSE_API_KEY=
EMAIL_VERIFY_PROVIDER=local                    # local|zerobounce|neverbounce|fake
EMAIL_VERIFY_API_KEY=
SOCIAL_PROFILE_ADAPTER_ENABLED=false           # DECISION: no official API route; off by default
DATA_PROVIDER=none                             # none|hunter|apollo (DECISION: evaluate hit rate before contracting)
DATA_PROVIDER_API_KEY=
ENRICHMENT_DAILY_LOOKUP_CAP=2000
EMAIL_VERIFY_DAILY_CAP=2000

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_LINK_URL=https://example.com/book

# Images
UNSPLASH_ACCESS_KEY=

# Legal identity (injected into every email footer)
LEGAL_ENTITY_NAME=Example Studio Ltd
LEGAL_ENTITY_REG_NO=C00000
LEGAL_ENTITY_ADDRESS=1 Example Street, Valletta, Malta
PRIVACY_POLICY_URL=https://example.com/privacy
DPO_EMAIL=privacy@example.com
AGENCY_NAME=Example Studio
AGENCY_URL=https://example.com

# Safety
KILL_SWITCH=false
MAX_SENDS_PER_DAY_GLOBAL=600
INCLUDE_HTTP_ONLY_SITES=false                  # DECISION: default exclude
PREVIEW_TTL_DAYS=30
