{
  "name": "@sitewright/db",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../.env -- tsx seed/index.ts",
    "studio": "dotenv -e ../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "dotenv-cli": "8.0.0"
  }
}
